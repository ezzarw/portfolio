---
import Icon from './Icon.astro';
import projects from '../data/projects.json';
import profile from '../data/profile.json';
const LIMIT = 10;
interface Project {
  title: string;
  status?: string;
  desc: string;
  tags: string[];
  wins: string[];
  img: string;
  live?: string;
  cta?: string;
  src?: string;
  category: string;
}
const projectList = projects as Project[];

// Ekstrak kategori unik secara dinamis dari data proyek
const categories = Array.from(
  new Set(projectList.map((p) => p.category).filter(Boolean))
);

const filters = [
  ['All', 'All', projectList.length],
  ...categories.map((cat) => [cat, cat, projectList.filter((p) => p.category === cat).length]),
];
const liveLabel = (url: string) =>
  url.includes('play.google.com')
    ? 'Get it on Google Play'
    : url.includes('apps.apple.com')
      ? 'Download on the App Store'
      : 'Visit live site';
---

<section id="works" class="block" data-projects data-limit={LIMIT}>
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="pill">Works</span>
      <h2>Projects</h2>
    </div>
    <div class="rails">
      {projects.length > 0 && (
        <div class="proj-bar">
          <h3>
            All Projects <span
              class="mono"
              style="font-size:13px;font-weight:400;color:var(--muted)"
              data-proj-count
              >{String(projects.length).padStart(2, '0')} projects</span>
          </h3>
          <div class="proj-bar__rule"></div>
          <div class="seg" role="group" aria-label="Filter projects">
            {
              filters.map(([k, tab, n], i) => (
                <button
                  type="button"
                  data-filter={k}
                  aria-pressed={i === 0 ? 'true' : 'false'}
                >
                  {tab} ({n})
                </button>
              ))
            }
          </div>
        </div>
      )}
      <div class="proj-grid">
        {
          projectList.length === 0 ? (
            <div class="empty-works">
              <div class="empty-works__card">
                <div class="empty-works__icon"><Icon name="trend" /></div>
                <h4>Belum Ada Proyek</h4>
                <p>Saat ini daftar proyek sedang dalam proses kurasi dan pengembangan aktif. Showcase proyek terbaru akan segera diperbarui di sini.</p>
              </div>
            </div>
          ) : (
            projectList.map((p, i) => (
            <article
              class={`card reveal${i === 0 ? ' card--featured' : ''}`}
              data-kind={p.category}
              hidden={i >= LIMIT}
            >
              <div class="card__visual">
                <div class="card__frame card__frame--bare">
                  <img
                    src={`${profile.projectCdn}${p.img}.webp`}
                    alt={p.title}
                    width="800"
                    height="500"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </div>
              <div class="card__body">
                <div class="card__kicker">
                  <>
                    <b data-num>{String(i + 1).padStart(2, '0')}</b>
                    <i />
                    <span>{p.category}</span>
                  </>
                </div>
                <h4>{p.title}</h4>
                <p class="card__desc">{p.desc}</p>
                {p.wins.map((w) => (
                  <div class="card__win">
                    <Icon name="trend" />
                    <span>{w}</span>
                  </div>
                ))}
                <div class="card__foot">
                  {p.tags.length || !p.live ? (
                    <div class="tags">
                      {p.tags.slice(0, i === 0 ? 5 : 3).map((t) => (
                        <span class="tag">{t}</span>
                      ))}
                    </div>
                  ) : (
                    <a class="card__cta" href={p.live} target="_blank" rel="noopener">
                      <span>{p.cta ?? liveLabel(p.live)}</span>
                      <b><Icon name="arrow" /></b>
                    </a>
                  )}
                  <div style="display:flex;gap:8px;flex-shrink:0">
                    {p.src && (
                      <a
                        class="round"
                        href={p.src}
                        target="_blank"
                        rel="noopener"
                        aria-label="Source code"
                      >
                        <Icon name="code" />
                      </a>
                    )}
                    {p.live && p.tags.length > 0 && (
                      <a
                        class="round round--dark"
                        href={p.live}
                        target="_blank"
                        rel="noopener"
                        aria-label="Live preview"
                      >
                        <Icon name="arrow" />
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </article>
          ))
          )
        }
      </div>
      <div class="more" hidden={projects.length <= LIMIT}>
        <button class="btn" type="button" data-more
          ><span data-more-label>Show all {projects.length} projects</span>
          <Icon name="chevron" /></button
        >
      </div>
    </div>
  </div>
</section>

<style>
  .empty-works {
    grid-column: 1 / -1;
    padding: 60px 24px;
    display: flex;
    justify-content: center;
  }
  .empty-works__card {
    max-width: 520px;
    text-align: center;
    padding: 44px 32px;
    border-radius: 16px;
    border: 1px dashed var(--line);
    background: var(--panel);
  }
  .empty-works__icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--teal-bg);
    color: var(--teal-d);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    margin: 0 auto 16px auto;
  }
  .empty-works__card h4 {
    font-size: 20px;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 8px;
  }
  .empty-works__card p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
  }
</style>
