---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import profile from '../data/profile.json';

interface Props {
  title: string;
  studioName: string;
  activeTab: 'projects' | 'skills' | 'journey' | 'education';
  description?: string;
}

const {
  title,
  studioName,
  activeTab,
  description = 'Local development studio for managing portfolio data',
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {profile.name}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/webp" href={profile.favicon} />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/instrument-sans-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/jetbrains-mono-latin.woff2" crossorigin />
  </head>
  <body class="admin-body">
    <div class="admin-shell">
      <!-- Unified Top Navigation Bar -->
      <header class="admin-topbar">
        <div class="wrap admin-topbar__inner">
          <div class="admin-topbar__left">
            <a href="/" class="admin-back-btn" title="Kembali ke halaman utama portofolio">
              <Icon name="chevron" />
              <span>Lihat Website</span>
            </a>
            <span class="admin-sep" aria-hidden="true">/</span>
            <div class="admin-brand-group">
              <span class="badge-dev">
                <span class="badge-dev__dot"></span>
                DEV STUDIO
              </span>
              <h1 class="admin-topbar__title">{studioName}</h1>
            </div>
          </div>

          <nav class="admin-nav" aria-label="Studio Navigation">
            <a href="/admin" class={`admin-nav__tab ${activeTab === 'projects' ? 'is-active' : ''}`}>
              <Icon name="code" />
              <span>Proyek</span>
            </a>
            <a href="/admin/skills" class={`admin-nav__tab ${activeTab === 'skills' ? 'is-active' : ''}`}>
              <Icon name="build" />
              <span>Keahlian</span>
            </a>
            <a href="/admin/journey" class={`admin-nav__tab ${activeTab === 'journey' ? 'is-active' : ''}`}>
              <Icon name="trend" />
              <span>My Journey</span>
            </a>
            <a href="/admin/education" class={`admin-nav__tab ${activeTab === 'education' ? 'is-active' : ''}`}>
              <Icon name="settings" />
              <span>Education</span>
            </a>
          </nav>

          <div class="admin-topbar__right">
            <slot name="topbar-actions" />
          </div>
        </div>
      </header>

      <!-- Studio Workspace -->
      <main class="wrap admin-workspace">
        <slot />
      </main>
    </div>
  </body>
</html>

<style is:global>
  .admin-body {
    background-color: #F4F7F9;
    background-image: radial-gradient(#CBD5E1 0.75px, transparent 0.75px);
    background-size: 24px 24px;
    color: var(--body);
    min-height: 100vh;
  }

  .admin-shell {
    min-height: 100vh;
    padding-bottom: 72px;
  }

  /* Topbar */
  .admin-topbar {
    position: sticky;
    top: 0;
    z-index: 45;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
    box-shadow: 0 1px 3px rgba(17, 24, 39, 0.03);
  }

  .admin-topbar__inner {
    min-height: 72px;
    padding-top: 10px;
    padding-bottom: 10px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .admin-topbar__left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .admin-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: #fff;
    color: var(--body);
    font-family: var(--mono);
    font-size: 12.5px;
    font-weight: 500;
    transition: all 0.2s var(--ease);
    box-shadow: 0 1px 2px rgba(17, 24, 39, 0.03);
  }

  .admin-back-btn svg {
    width: 15px;
    height: 15px;
    transform: rotate(90deg);
    transition: transform 0.2s var(--ease);
  }

  .admin-back-btn:hover {
    border-color: var(--teal);
    background: var(--teal-bg2);
    color: var(--teal-d);
  }

  .admin-back-btn:hover svg {
    transform: rotate(90deg) translateY(2px);
  }

  .admin-sep {
    color: #CBD5E1;
    font-size: 16px;
    user-select: none;
  }

  .admin-brand-group {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .badge-dev {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--teal-bg);
    color: var(--teal-d);
    border: 1px solid #B6E6EE;
  }

  .badge-dev__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--teal);
    animation: pulse 2s infinite;
  }

  .admin-topbar__title {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0;
  }

  /* Navigation Tabs */
  .admin-nav {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px;
    border-radius: 10px;
    background: #F1F5F9;
    border: 1px solid var(--line);
  }

  .admin-nav__tab {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 14px;
    border-radius: 7px;
    font-size: 13px;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
    transition: all 0.18s var(--ease);
    white-space: nowrap;
  }

  .admin-nav__tab .icon {
    width: 15px;
    height: 15px;
    opacity: 0.75;
  }

  .admin-nav__tab:hover {
    color: var(--ink);
    background: rgba(255, 255, 255, 0.65);
  }

  .admin-nav__tab.is-active {
    background: #fff;
    color: var(--teal-d);
    font-weight: 600;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.08), 0 0 0 1px rgba(23, 162, 184, 0.15);
  }

  .admin-nav__tab.is-active .icon {
    opacity: 1;
    color: var(--teal);
  }

  .admin-topbar__right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .stat-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 999px;
    background: #F8FAFC;
    border: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
  }

  .stat-pill b {
    color: var(--ink);
    font-weight: 700;
  }

  /* Workspace Grid */
  .admin-workspace {
    margin-top: 28px;
    display: grid;
    grid-template-columns: 400px minmax(0, 1fr);
    gap: 24px;
    align-items: start;
  }

  @media (max-width: 1024px) {
    .admin-workspace {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .admin-topbar__inner {
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
    }
    .admin-topbar__left,
    .admin-topbar__right {
      justify-content: space-between;
    }
    .admin-nav {
      overflow-x: auto;
      justify-content: flex-start;
    }
  }

  /* Panels */
  .admin-panel {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.04);
    overflow: hidden;
  }

  .admin-list-panel {
    position: sticky;
    top: 96px;
    max-height: calc(100vh - 116px);
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 1024px) {
    .admin-list-panel {
      position: static;
      max-height: none;
    }
  }

  .panel-head {
    padding: 18px 22px;
    border-bottom: 1px solid var(--line);
    background: linear-gradient(180deg, #FFFFFF 0%, #FAFBFD 100%);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    flex-shrink: 0;
  }

  .panel-head__info {
    min-width: 0;
  }

  .panel-head h2,
  .panel-head h3 {
    font-size: 16px;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.01em;
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
  }

  .panel-head .sub {
    font-size: 12.5px;
    color: var(--muted);
    margin-top: 3px;
  }

  .panel-toolbar {
    padding: 10px 16px;
    background: #F8FAFC;
    border-bottom: 1px solid var(--line);
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    flex-shrink: 0;
  }

  .f-btn {
    appearance: none;
    background: transparent;
    border: 1px solid transparent;
    padding: 5px 11px;
    font-size: 11.5px;
    font-family: var(--mono);
    font-weight: 500;
    color: var(--muted);
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.18s var(--ease);
  }

  .f-btn:hover {
    color: var(--ink);
    background: #fff;
    border-color: var(--line);
  }

  .f-btn.active {
    background: var(--teal);
    color: #fff;
    border-color: var(--teal);
    font-weight: 600;
    box-shadow: 0 2px 6px rgba(23, 162, 184, 0.25);
  }

  /* Mode Badge on Form Header */
  .mode-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--mono);
    font-size: 10.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 3px 8px;
    border-radius: 6px;
    background: var(--teal-bg);
    color: var(--teal-d);
    margin-bottom: 6px;
  }

  .mode-badge.is-edit {
    background: #FEF3C7;
    color: #B45309;
  }

  /* Scrollable Left List */
  .studio-list {
    flex: 1 1 auto;
    min-height: 0;
    max-height: calc(100vh - 210px);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  @media (max-width: 1024px) {
    .studio-list {
      max-height: 520px;
    }
  }

  .studio-list > * {
    flex-shrink: 0;
  }

  .studio-list::-webkit-scrollbar {
    width: 6px;
  }
  .studio-list::-webkit-scrollbar-track {
    background: transparent;
  }
  .studio-list::-webkit-scrollbar-thumb {
    background: #CBD5E1;
    border-radius: 999px;
  }
  .studio-list::-webkit-scrollbar-thumb:hover {
    background: #94A3B8;
  }

  /* List Item Card */
  .list-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: #fff;
    cursor: pointer;
    transition: all 0.18s var(--ease);
    text-align: left;
    position: relative;
    flex-shrink: 0;
  }

  .list-card:hover {
    border-color: #9ED9E3;
    background: var(--teal-bg2);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(15, 138, 157, 0.07);
  }

  .list-card.is-selected {
    border-color: var(--teal);
    background: var(--teal-bg);
    box-shadow: inset 3px 0 0 var(--teal-d), 0 2px 8px rgba(15, 138, 157, 0.1);
  }

  .list-card__thumb {
    width: 46px;
    height: 46px;
    border-radius: 10px;
    background: #F8FAFC;
    border: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
    padding: 4px;
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 700;
    color: var(--teal-d);
  }

  .list-card__thumb--cover {
    padding: 0;
  }

  .list-card__thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 6px;
  }

  .list-card__thumb--cover img {
    object-fit: cover;
    border-radius: 0;
  }

  .list-card__body {
    flex: 1;
    min-width: 0;
  }

  .list-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .list-card__title {
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .list-card__badge {
    font-family: var(--mono);
    font-size: 10.5px;
    font-weight: 500;
    padding: 2px 7px;
    border-radius: 999px;
    background: #F1F5F9;
    color: #475569;
    border: 1px solid var(--line);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .list-card__badge--teal {
    background: var(--teal-bg);
    color: var(--teal-d);
    border-color: #B6E6EE;
  }

  .list-card__badge--green {
    background: #EAF8EE;
    color: #1F8A3B;
    border-color: #BBF7D0;
  }

  .list-card__badge--amber {
    background: #FFFBEB;
    color: #B45309;
    border-color: #FDE68A;
  }

  .list-card__sub {
    font-size: 12.5px;
    color: var(--teal-d);
    font-weight: 500;
    margin-top: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .list-card__meta {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    margin-top: 4px;
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Empty State */
  .empty-state {
    padding: 40px 20px;
    text-align: center;
    color: var(--muted);
    background: #FAFBFD;
    border: 1px dashed var(--line);
    border-radius: 10px;
    margin: 4px;
  }

  .empty-state__icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--teal-bg);
    color: var(--teal-d);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 10px;
    font-size: 18px;
  }

  .empty-state h4 {
    font-size: 14.5px;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 4px;
  }

  .empty-state p {
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--muted);
    max-width: 280px;
    margin: 0 auto;
  }

  /* Form Layout & Controls */
  .studio-form {
    padding: 24px;
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  @media (max-width: 640px) {
    .form-grid {
      grid-template-columns: 1fr;
    }
    .field.span-2 {
      grid-column: span 1 !important;
    }
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .field.span-2 {
    grid-column: span 2;
  }

  .field-label-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .field label {
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
  }

  .field .req {
    color: #DC2626;
    margin-left: 2px;
  }

  .field .hint {
    font-size: 11.5px;
    color: var(--muted);
    line-height: 1.45;
  }

  .field .hint code {
    font-family: var(--mono);
    font-size: 11px;
    background: #F1F5F9;
    padding: 1px 5px;
    border-radius: 4px;
    color: var(--body);
  }

  .studio-form input[type="text"],
  .studio-form input[type="url"],
  .studio-form input[type="number"],
  .studio-form input[type="date"],
  .studio-form select,
  .studio-form textarea {
    width: 100%;
    padding: 10px 13px;
    border-radius: 8px;
    border: 1px solid var(--line);
    font-family: var(--sans);
    font-size: 13.5px;
    color: var(--ink);
    background: #fff;
    outline: none;
    transition: border-color 0.18s var(--ease), box-shadow 0.18s var(--ease);
  }

  .studio-form textarea {
    resize: vertical;
    line-height: 1.6;
  }

  .studio-form input:focus,
  .studio-form select:focus,
  .studio-form textarea:focus {
    border-color: var(--teal);
    box-shadow: 0 0 0 3px rgba(23, 162, 184, 0.14);
  }

  /* Media Upload Box (Unified across all studios) */
  .media-box {
    background: #F8FAFC;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .media-box__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
  }

  .media-box__title {
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
  }

  .media-box__badge {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    background: #fff;
    padding: 2px 8px;
    border-radius: 6px;
    border: 1px solid var(--line);
  }

  .media-box__main {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  @media (max-width: 560px) {
    .media-box__main {
      flex-direction: column;
      align-items: stretch;
    }
  }

  .media-preview {
    width: 72px;
    height: 72px;
    border-radius: 10px;
    background: #fff;
    border: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
    padding: 6px;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
  }

  .media-preview--wide {
    width: 112px;
    height: 72px;
    padding: 0;
  }

  .media-preview img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .media-preview--wide img {
    object-fit: cover;
  }

  .media-preview__ph {
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--muted);
    text-align: center;
    line-height: 1.2;
  }

  .media-controls {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .slug-group {
    display: flex;
    align-items: center;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    transition: border-color 0.18s var(--ease), box-shadow 0.18s var(--ease);
  }

  .slug-group:focus-within {
    border-color: var(--teal);
    box-shadow: 0 0 0 3px rgba(23, 162, 184, 0.14);
  }

  .slug-group__affix {
    padding: 9px 11px;
    background: #F1F5F9;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 12px;
    white-space: nowrap;
    user-select: none;
  }

  .slug-group__affix--left {
    border-right: 1px solid var(--line);
  }

  .slug-group__affix--right {
    border-left: 1px solid var(--line);
  }

  .slug-group input {
    border: none !important;
    box-shadow: none !important;
    padding: 9px 10px !important;
    font-family: var(--mono) !important;
    font-size: 13px !important;
    border-radius: 0 !important;
    flex: 1;
    min-width: 0;
  }

  .upload-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    background: #fff;
    padding: 8px 10px;
    border-radius: 8px;
    border: 1px dashed #CBD5E1;
  }

  .upload-bar input[type="file"] {
    flex: 1;
    min-width: 180px;
    font-size: 12px;
    color: var(--muted);
  }

  .upload-bar input[type="file"]::file-selector-button {
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 500;
    padding: 5px 11px;
    margin-right: 10px;
    border-radius: 6px;
    border: 1px solid var(--line);
    background: #F8FAFC;
    color: var(--ink);
    cursor: pointer;
    transition: all 0.15s;
  }

  .upload-bar input[type="file"]::file-selector-button:hover {
    border-color: var(--teal);
    background: var(--teal-bg2);
    color: var(--teal-d);
  }

  /* Dynamic Rows (Wins / Highlights) */
  .dyn-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .dyn-row {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #F8FAFC;
    padding: 8px;
    border-radius: 8px;
    border: 1px solid var(--line);
  }

  @media (max-width: 640px) {
    .dyn-row {
      flex-wrap: wrap;
    }
  }

  .dyn-row input {
    min-width: 0;
  }

  .btn-icon-del {
    width: 34px;
